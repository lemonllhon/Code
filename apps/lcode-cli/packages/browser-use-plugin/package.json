{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@lcode/browser-use-plugin",
  "version": "0.5.1",
  "private": true,
  "description": "作为官方 LCode 内置插件发布的 Browser Use skill 与 client runtime；node_repl MCP server 由 @lcode/node-repl-host 提供。",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/mcp/server.js",
  "scripts": {
    "build": "tsc && node scripts/build.mjs",
    "clean": "node ../../scripts/clean-dist.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config ../../oxlint.config.json src --no-ignore"
  },
  "dependencies": {
    "@lcode/core": "workspace:*",
    "@lcode/node-repl-host": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
